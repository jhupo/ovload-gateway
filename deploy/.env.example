# Copy to deploy/.env for Compose; select an existing release or dev for local builds.
OVLOAD_VERSION=0.1.0
OVLOAD_IMAGE_PREFIX=ghcr.io/jhupo/ovload-gateway
OVLOAD_BIND=127.0.0.1
OVLOAD_PORT=8080
RUST_LOG=info

# Generate a random URL-safe hexadecimal secret; never commit deploy/.env.
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
# Infrastructure versions are independent of OVLOAD_VERSION.
POSTGRES_IMAGE=postgres:17.9-bookworm
REDIS_IMAGE=redis:7.4.8-bookworm

CADDY_IMAGE=caddy:2.10.2-alpine
