# Keep the actual environment and private files outside the source/build context.
OVLOAD_IMAGE=ovload-gateway:local
OVLOAD_BIND=0.0.0.0
OVLOAD_PORT=51771
OVLOAD_PUBLIC_HOST=localhost
# Canonical HTTPS origin used by browser identity protections and callback links.
# Change this value when the public domain or port changes; do not rebuild the image.
OVLOAD_PUBLIC_ORIGIN=https://localhost
OVLOAD_CONFIG_DIRECTORY=../private

# BuildKit is required. Cargo object files use tmpfs; allow sufficient RAM.
# Use dev on the resource-constrained test server; its binary is stripped.
OVLOAD_CARGO_PROFILE=release
OVLOAD_BUILD_JOBS=1
OVLOAD_RUN_BACKEND_TESTS=false
OVLOAD_REVISION=unknown
OVLOAD_BUILD_TIME=unknown
# Optional non-authenticated build proxy, passed only as standard build arguments.
OVLOAD_BUILD_PROXY=
OVLOAD_BUILD_NO_PROXY=localhost,127.0.0.1,::1

# Optional Antigravity OAuth client registration. Keep these values outside Git.
# CPR_ANTIGRAVITY_CLIENT_ID=
# CPR_ANTIGRAVITY_CLIENT_SECRET=

# Private directory inputs:
# config.yaml: complete deploy/config.example.yaml schema, gateway uid 10001 readable.
# Set runtime_data_dir=../.runtime/data and logging.file.directory=../.runtime/logs.
# OVLOAD_PUBLIC_ORIGIN is required and must be the exact external HTTPS origin,
# including its port; it overrides api.identity_public_origin at runtime.
# provider-credentials.key: exactly 32 random raw bytes, mode 0400, uid 10001.
# postgres-password: same password as config.yaml store.database.password.
# redis-password: same password as config.yaml store.redis.password.
# redis.conf: bind 0.0.0.0; protected-mode yes; dir /data; appendonly yes;
#            maxmemory 256mb; maxmemory-policy noeviction; requirepass <redis-password>.
# Redis runs as uid 999; its two secret files must be readable by that uid.
# TLS is terminated by the host ingress or Cloudflare Tunnel, not by Compose.

POSTGRES_IMAGE=postgres:17.9-bookworm
REDIS_IMAGE=redis:7.4.8-bookworm
