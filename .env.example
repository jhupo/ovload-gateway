# Set in the shell; the server does not automatically load this file.
OVLOAD_LISTEN=127.0.0.1:8080
RUST_LOG=info
# Required by deployed serve mode; preview mode is explicitly stateless.
OVLOAD_WEB_DIR=web/dist
DATABASE_URL=postgres://ovload:replace-with-a-url-safe-secret@127.0.0.1:5432/ovload
REDIS_URL=redis://127.0.0.1:6379/0
